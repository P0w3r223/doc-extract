.venv/
__pycache__/
*.py[cod]
*.egg-info/
# `pip wheel .` / `python -m build` leave a copy of the package here. Left in place it is not just
# clutter: `ruff` lints it as source, and the per-file-ignores in pyproject.toml are keyed to paths
# under `src/`, so the copy reports errors the original is exempt from.
build/
dist/
.pytest_cache/
.ruff_cache/
.env

# Generated corpora: reproducible from a seed, not versioned. The manifest in a run's `run.meta.json`
# records which corpus a result was computed on, so the bytes do not have to travel with it.
data/synthetic/

# `results/` is deliberately NOT ignored. The metric rules require the prediction files to be
# committed: a report is recomputable from `predictions.jsonl` alone, which is what makes a number
# checkable without re-running a model that costs money — and what makes a change to the scorer a
# reviewable diff in the numbers rather than a claim.

# Working notes for the assistant sessions, not part of the project. Scoped to `sessions/` so a
# checked-in `.claude/settings.json` would still be versioned if one is ever added.
.claude/sessions/
